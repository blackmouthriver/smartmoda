# Plantilla de configuracion local. EN-0005.
#
# Las variables de Android van en local.properties, no aqui: Gradle las lee de ese archivo.
# Este .env es para los scripts de Python (importador de Azure DevOps, herramientas).
#
# NINGUNO de los dos se sube al repositorio. Ambos estan en .gitignore.

# --- Supabase (Fase 1) --------------------------------------------------
# Panel > Project Settings > API
# Estas dos van en local.properties, NO aqui. Se listan como recordatorio.
#   SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
#   SUPABASE_ANON_KEY=la-clave-anon
#
# La clave service_role NO se configura en ningun sitio del proyecto.
# Omite el Row Level Security y no puede llegar a un cliente. Ver supabase/README.md

# --- Azure DevOps (solo para importar el backlog) -----------------------
ADO_ORG=https://dev.azure.com/proyectoOutfit
ADO_PROJECT=Outfit
ADO_PAT=

# --- Firebase (Crashlytics, App Distribution) · Sprint 5 ----------------
FIREBASE_PROJECT_ID=
